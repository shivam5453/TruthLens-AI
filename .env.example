# ============================================================
# TruthLens AI - Backend Environment Configuration Example
# ============================================================
# Copy this file to .env and provide your actual configuration values.
# NEVER commit the real .env file or real secrets to Git.

# MongoDB Connection String (e.g. mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority)
MONGODB_URL=

# Allowed Production Frontend URL for CORS (e.g. https://truthlens-ai.vercel.app)
FRONTEND_URL=
