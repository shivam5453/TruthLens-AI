# ============================================================
# TruthLens AI - Backend Environment Configuration Example
# ============================================================
# Copy this file to .env and provide your actual configuration values.
# NEVER commit the real .env file or real secrets to Git.

# MongoDB Connection String (e.g. mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority)
MONGODB_URL=

# Allowed Production Frontend URL for CORS (e.g. https://truthlens-ai.vercel.app)
FRONTEND_URL=

# JWT Secret Key for Authenticated User Sessions
JWT_SECRET_KEY=

# Default Administrator Email (automatically assigned admin role on register)
ADMIN_EMAIL=admin@truthlens.ai

# Secret passphrase required to invoke server-side POST /api/auth/bootstrap-admin
ADMIN_BOOTSTRAP_SECRET=

# Live Web Evidence Retrieval Timeout in seconds (default: 7.0)
EVIDENCE_TIMEOUT=7.0
